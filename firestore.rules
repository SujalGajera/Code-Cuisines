rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    function isReceptionist() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/receptionist/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/receptionist/$(request.auth.uid)).data.role == "receptionist"
      );
    }

    // Admin users collection
    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Receptionist collection
    match /receptionist/{uid} {
      allow create: if isSignedIn();
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow update: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow delete: if isAdmin();

      // Shifts subcollection
      match /shifts/{shiftId} {
        allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin() || isReceptionist();
        allow write: if isAdmin();
      }
    }

    // Customer collection
    match /customer/{uid} {
      allow create: if isSignedIn();
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow update: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow delete: if isAdmin();

      // Orders subcollection
      match /orders/{orderId} {
        allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update, delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      }

      // Feedback subcollection
      match /feedback/{feedbackId} {
        allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update, delete: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      }
    }

    // Top-level reservations (shared resource)
    match /reservations/{resId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin() || isReceptionist();
    }

    // Menu items
    match /menu/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else admin-only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
